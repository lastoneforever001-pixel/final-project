    "import os\n",
    "import json\n",
    "import sqlite3\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "class Book:\n",
    "    def __init__(self, book_id, title, price, stock):\n",
    "        self.id = book_id\n",
    "        self.title = title\n",
    "        self.price = float(price)\n",
    "        self.stock = int(stock)\n",
    "\n",
    "    def display(self):\n",
    "        return f\"📖 [{self.id}] '{self.title}' - ${self.price:.2f} | Stock: {self.stock}\"\n",
    "\n",
    "class ShoppingCart:\n",
    "    def __init__(self):\n",
    "        self.items = {}  \n",
    "    def add_book(self, book_id, qty):\n",
    "        self.items[book_id] = self.items.get(book_id, 0) + qty\n",
    "\n",
    "    def clear(self):\n",
    "        self.items.clear()\n",
    "\n",
    "\n",
    "class BookStoreEngine:\n",
    "    def __init__(self):\n",
    "        self.db_path = \"bookstore.db\"\n",
    "        self.json_path = \"sales_history.json\"\n",
    "        self.setup_database()\n",
    "\n",
    "    def setup_database(self):\n",
    "        \"\"\"Creates an internal SQL database and stocks books on the first boot.\"\"\"\n",
    "        conn = sqlite3.connect(self.db_path)\n",
    "        cursor = conn.cursor()\n",
    "        cursor.execute(\"\"\"\n",
    "            CREATE TABLE IF NOT EXISTS inventory (\n",
    "                id INTEGER PRIMARY KEY,\n",
    "                title TEXT,\n",
    "                price REAL,\n",
    "                stock INTEGER\n",
    "            )\n",
    "        \"\"\")\n",
    "        \n",
    "       \n",
    "        cursor.execute(\"SELECT COUNT(*) FROM inventory\")\n",
    "        if cursor.fetchone()[0] == 0:\n",
    "            sample_books = [\n",
    "                (1, \"Python Basics\", 29.99, 10),\n",
    "                (2, \"Data Science Handbook\", 45.50, 5),\n",
    "                (3, \"SQL Performance Pro\", 39.90, 8)\n",
    "            ]\n",
    "            cursor.executemany(\"INSERT INTO inventory VALUES (?, ?, ?, ?)\", sample_books)\n",
    "            conn.commit()\n",
    "        conn.close()\n",
    "\n",
    "    def get_all_books(self):\n",
    "        conn = sqlite3.connect(self.db_path)\n",
    "        cursor = conn.cursor()\n",
    "        cursor.execute(\"SELECT id, title, price, stock FROM inventory\")\n",
    "        books = [Book(*row) for row in cursor.fetchall()]\n",
    "        conn.close()\n",
    "        return books\n",
    "\n",
    "    def checkout(self, cart: ShoppingCart):\n",
    "        \"\"\"Executes a secure transaction, checks stock limits, and logs sales.\"\"\"\n",
    "        if not cart.items:\n",
    "            print(\"\\n Your cart is empty!\")\n",
    "            return\n",
    "\n",
    "        conn = sqlite3.connect(self.db_path)\n",
    "        cursor = conn.cursor()\n",
    "        \n",
    "        total_bill = 0.0\n",
    "        for b_id, qty in cart.items.items():\n",
    "            cursor.execute(\"SELECT title, price, stock FROM inventory WHERE id = ?\", (b_id,))\n",
    "            row = cursor.fetchone()\n",
    "            if not row or row[2] < qty:\n",
    "                print(f\"\\n Error: Out of stock or invalid Book ID {b_id}!\")\n",
    "                conn.close()\n",
    "                return\n",
    "            \n",
    "            total_bill += row[1] * qty\n",
    "            # Deduct stock counts in SQL\n",
    "            cursor.execute(\"UPDATE inventory SET stock = stock - ? WHERE id = ?\", (qty, b_id))\n",
    "\n",
    "        conn.commit()\n",
    "        conn.close()\n",
    "\n",
    "        # Append data to the JSON ledger\n",
    "        self.save_sales_json(total_bill)\n",
    "        cart.clear()\n",
    "        print(f\"\\n Checkout complete! Total charged: ${total_bill:.2f}\")\n",
    "\n",
    "    def save_sales_json(self, bill_amount):\n",
    "        \"\"\"Appends records to a JSON file format structure.\"\"\"\n",
    "        if os.path.exists(self.json_path):\n",
    "            with open(self.json_path, \"r\") as file:\n",
    "                history = json.load(file)\n",
    "        else:\n",
    "            history = []\n",
    "\n",
    "        history.append({\"order_index\": len(history) + 1, \"sale_value\": bill_amount})\n",
    "        \n",
    "        with open(self.json_path, \"w\") as file:\n",
    "            json.dump(history, file, indent=4)\n",
    "\n",
    "    def show_chart(self):\n",
    "        \"\"\"Builds a chart using Pandas and Matplotlib.\"\"\"\n",
    "        if not os.path.exists(self.json_path):\n",
    "            print(\"\\n No sales history available to map yet.\")\n",
    "            return\n",
    "\n",
    "        df = pd.read_json(self.json_path)\n",
    "        df['cumulative_sales'] = df['sale_value'].cumsum()\n",
    "\n",
    "        print(\"\\n--- Sales Matrix Overview (Pandas) ---\")\n",
    "        print(df.to_string(index=False))\n",
    "\n",
    "        # Matplotlib Graph Setup\n",
    "        plt.figure(figsize=(7, 4))\n",
    "        plt.plot(df['order_index'], df['cumulative_sales'], marker='o', color='purple', linewidth=2)\n",
    "        plt.title(\"SimpleBook Cumulative Sales Ledger\", fontsize=12, fontweight='bold')\n",
    "        plt.xlabel(\"Order Sequence Index\")\n",
    "        plt.ylabel(\"Cumulative Revenue ($)\")\n",
    "        plt.grid(True, linestyle=':')\n",
    "        plt.xticks(df['order_index'])\n",
    "        plt.show()\n",
    "\n",
    "\n",
    "def start_store():\n",
    "    store = BookStoreEngine()\n",
    "    cart = ShoppingCart()\n",
    "\n",
    "    while True:\n",
    "        print(\"\\n=== BOOKSTORE CLI ===\")\n",
    "        print(\"1. View Book Catalog\")\n",
    "        print(\"2. Add Book to Cart\")\n",
    "        print(\"3. View Cart\")\n",
    "        print(\"4. Checkout (SQL)\")\n",
    "        print(\"5. View Cumulative Growth Chart\")\n",
    "        print(\"6. Exit\")\n",
    "        \n",
    "        choice = input(\"Enter choice [1-6]: \").strip()\n",
    "\n",
    "        if choice == \"1\":\n",
    "            print(\"\\n--- Book Inventory ---\")\n",
    "            for book in store.get_all_books():\n",
    "                print(book.display())\n",
    "        elif choice == \"2\":\n",
    "            try:\n",
    "                b_id = int(input(\"Enter Book ID to add: \"))\n",
    "                qty = int(input(\"Enter Quantity: \"))\n",
    "                if qty > 0:\n",
    "                    cart.add_book(b_id, qty)\n",
    "                    print(\" Added to cart.\")\n",
    "                else:\n",
    "                    print(\"Quantity must be greater than 0.\")\n",
    "            except ValueError:\n",
    "                print(\"Invalid number input format.\")\n",
    "        elif choice == \"3\":\n",
    "            print(\"\\n--- Current Session Cart ---\")\n",
    "            print(cart.items if cart.items else \"Your cart is empty.\")\n",
    "        elif choice == \"4\":\n",
    "            store.checkout(cart)\n",
    "        elif choice == \"5\":\n",
    "            store.show_chart()\n",
    "        elif choice == \"6\":\n",
    "            print(\"\\nGoodbye!\")\n",
    "            break\n",
    "        else:\n",
    "            print(\" Invalid choice selection.\")\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    start_store()\n"
   ]
  }
